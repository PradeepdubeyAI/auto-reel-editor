# Copy this file to .env in the repo root and fill in the keys you have.
# The app degrades gracefully per feature -- e.g. skip SARVAM_API_KEY if you
# only transcribe with ElevenLabs, skip PIXABAY_API_KEY if you only use Pexels.

# --- transcription (pick at least one) ---
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# --- LLM calls: Hinglish romanization, hook trim, retake detection ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
RETAKE_MODEL=gpt-4o

# --- b-roll stock footage (pick at least one) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- optional ---
# DEEPFILTER_BIN=/path/to/deep-filter          # AI voice denoiser, falls back to ffmpeg afftdn
# AGENT_PROJECTS_DIR=~/.video-agent/projects/   # where transcription/pipeline working dirs live
# PYCAPS_BIN=/path/to/.pycaps-venv/bin/pycaps   # see docs for the separate pycaps venv setup
